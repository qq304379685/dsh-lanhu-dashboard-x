{
  "name": "dsh-lanhu-proto",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "蓝湖产品原型（Axure）读取插件：路径映射代理 + 同源 iframe 面板 + 工具",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
