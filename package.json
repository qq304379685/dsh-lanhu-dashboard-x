{
  "name": "dsh-lanhu-proto",
  "version": "0.1.2",
  "private": false,
  "type": "module",
  "description": "蓝湖产品原型（Axure）读取插件：路径映射代理 + 同源 iframe 面板 + 工具",
  "license": "MIT",
  "author": "qq304379685",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qq304379685/dsh-lanhu-dashboard-x.git"
  },
  "homepage": "https://github.com/qq304379685/dsh-lanhu-dashboard-x#readme",
  "keywords": [
    "dsh-plugin",
    "dsh",
    "lanhu",
    "axure",
    "prototype"
  ],
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
